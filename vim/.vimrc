" General settings
set nocompatible
set scrolloff=7
set showmatch
set ignorecase
set smartcase
set hlsearch
set incsearch
set cursorline
set tabstop=4
set softtabstop=4
set expandtab
set shiftwidth=4
set autoindent
set wildmode=longest,list
set nobackup
set nowritebackup
set noswapfile
set number
set laststatus=2
set statusline=%f\ %m%r%h%w\ %=%y\ [%l,%c]\ %p%%

" Enable syntax highlighting
syntax on

" File type detection and indentation
filetype plugin indent on
