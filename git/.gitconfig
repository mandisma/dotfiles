[color]
	ui = true

[core]
	excludesfile = ~/.global-gitignore
	pager = delta
	editor = vim

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
	syntax-theme = "Dracula"

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictstyle = diff3

[rebase]
	autoStash = true

[rerere]
	enabled = true

[alias]
	gone = "!git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D"

[gpg]
	format = ssh

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[include]
	path = ~/.gitconfig.local

